# Staff console (runs on port 3001). Copy to admin/.env.local.
# Same database as the main site.
DATABASE_URL=postgresql://user:password@host:port/railway
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# Own session cookie names, so staff and site sessions don't collide on localhost.
AUTH_COOKIE_PREFIX=peeps-admin

# "View public site" link in the console sidebar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
