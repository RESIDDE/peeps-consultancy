# Local SQLite file by default. For production, point at a Turso/libSQL URL.
DATABASE_URL=file:peeps.db
DATABASE_AUTH_TOKEN=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Extra origins allowed to call auth endpoints in production (comma-separated)
TRUSTED_ORIGINS=
