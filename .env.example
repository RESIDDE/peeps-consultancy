# Postgres connection string. Locally, use the Postgres-dev service's public URL
# from Railway; in production Railway sets ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://user:password@host:port/railway

# Allows db:reset / db:seed to wipe and fill this database with demo data.
# Set to 1 only for the dev database, never in production.
PEEPS_DEV_DB=1

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Extra origins allowed to call auth endpoints in production (comma-separated)
TRUSTED_ORIGINS=

# Production only: db:migrate creates this admin account if it doesn't exist.
# Leave unset locally (the demo seed creates admin@peeps.local instead).
ADMIN_EMAIL=
ADMIN_PASSWORD=
